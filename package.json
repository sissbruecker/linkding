{
  "name": "linkding",
  "scripts": {
    "build": "npm run build-js && npm run build-theme-light && npm run build-theme-dark",
    "build-js": "esbuild bookmarks/frontend/index.js --bundle --minify --sourcemap --format=iife --outfile=bookmarks/static/bundle.js",
    "build-theme-light": "esbuild bookmarks/styles/theme-light.css --bundle --minify --external:*.svg --target=chrome109,firefox115,safari16 --outfile=bookmarks/static/theme-light.css",
    "build-theme-dark": "esbuild bookmarks/styles/theme-dark.css --bundle --minify --external:*.svg --target=chrome109,firefox115,safari16 --outfile=bookmarks/static/theme-dark.css",
    "dev": "esbuild bookmarks/frontend/dev.js --bundle --sourcemap --format=iife --outfile=bookmarks/static/bundle.js --watch"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.7.4",
    "@hotwired/turbo": "^8.0.21",
    "esbuild": "^0.28.2",
    "lit": "^3.3.1"
  },
  "devDependencies": {
    "prettier": "^3.3.3"
  }
}
